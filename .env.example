# Malli paikallisesta .env-tiedostosta. Kopioi: cp .env.example .env  ja täytä omat arvot.
# .env on .gitignoressa, joten salasana ei päädy GitHubiin. Älä kirjoita oikeaa salasanaa tähän tiedostoon.
SPRING_PROFILES_ACTIVE=prod
